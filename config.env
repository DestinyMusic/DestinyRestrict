# ==============================================================================
# 🔴 COMPULSORY VARIABLES (Core Credentials & Database)
# ==============================================================================

# Get your API ID and HASH from https://my.telegram.org
API_ID=
API_HASH=

# Get your Bot Token from @BotFather
BOT_TOKEN=

# MongoDB Atlas Connection URI (Replace <password> with your actual DB password)
DB_URI=

# MongoDB Database name (Leave as DestinyRestrict or change it)
DB_NAME=


# ==============================================================================
# 🟡 OPTIONAL: LOG CHANNEL 
# ==============================================================================

# The channel ID for the 4GB Premium Bypass and error logs (e.g., -1001234567890)
LOG_CHANNEL=


# ==============================================================================
# ⚙️ OPTIONAL: OPERATIONAL SETTINGS
# ==============================================================================

# Enable or disable user session login via the /login command (True or False)
LOGIN_SYSTEM=True

# Send error notifications directly to the user or log channel (True or False)
ERROR_MESSAGE=True

# Default delay (in seconds) between consecutive bot tasks to prevent flooding
WAITING_TIME=3

# Webserver port for uptime ping monitoring on Render/Hugging Face
PORT=8080


# ==============================================================================
# 👥 ACCESS CONTROL (Permissions)
# ==============================================================================

# Comma-Separated Telegram User IDs for Admins (e.g., 123456789, 987654321)
ADMINS=

# Comma-Separated Telegram User IDs for Sudo users
SUDOS=
